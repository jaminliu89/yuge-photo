---
import Layout from '../layouts/BaseLayout.astro'
import { getAllPosts } from '../sanity'

const allPosts = await getAllPosts()
const allCats = [...new Set(allPosts.map(p => p.category).filter(Boolean))]
const cat = Astro.url.searchParams.get('cat')
const posts = cat ? allPosts.filter(p => p.category === cat) : allPosts
---

<Layout title="宇哥摄影 · 摄影教程与技巧分享" description="专业摄影教程，构图技巧、后期调色、器材评测、人像风光实战。宇哥手把手带你从入门到精通。">
  <main>
    <section class="hero">
      <div class="hc">
        <div class="hb">免费 · 每周更新</div>
        <h1>学摄影，从宇哥开始</h1>
        <p>构图、人像、风光、后期调色、器材评测——每一篇都是实拍经验，附视频讲解</p>
        <div class="stats">
          <div class="si"><div class="sn">{allPosts.length}</div><div class="sl">免费教程</div></div>
          <div class="si"><div class="sn">{allCats.length}</div><div class="sl">分类</div></div>
          <div class="si"><div class="sn">每周</div><div class="sl">更新</div></div>
        </div>
      </div>
    </section>

    <div class="cats">
      <a href="/" class="cat-btn{!cat ? ' active' : ''}">全部</a>
      {allCats.map(c => (
        <a href={`/?cat=${c}`} class="cat-btn{cat === c ? ' active' : ''}">{c}</a>
      ))}
    </div>

    <div class="grid">
      {posts.map(post => (
        <a href={`/posts/${post.slug.current}`} class="card">
          {post.heroImageUrl && <img src={post.heroImageUrl} alt={post.title} class="ci" loading="lazy" />}
          <div class="cb">
            <div class="cm"><span class="ct">{post.category}</span>{post.level && <span class="cl">{post.level}</span>}</div>
            <h2 class="ctitle">{post.title}</h2>
            <p class="cd">{post.description}</p>
            <div class="cf">
              <time>{new Date(post.publishedAt).toLocaleDateString('zh-CN')}</time>
              {post.videos?.length > 0 && <span class="cv">🎬 含视频</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  main { max-width: 960px; margin: 0 auto; padding: 0 20px 60px; }
  .hero { text-align: center; padding: 60px 0 40px; }
  .hc { max-width: 600px; margin: 0 auto; }
  .hb { display: inline-block; background: var(--red-l); color: var(--red-t); padding: 4px 14px; border-radius: 999px; font-size: 13px; font-weight: 600; margin-bottom: 16px; }
  .hero h1 { font-size: 36px; font-weight: 700; line-height: 1.2; margin-bottom: 12px; letter-spacing: -0.5px; }
  .hero p { color: var(--text-sec); font-size: 16px; line-height: 1.6; margin-bottom: 28px; }
  .stats { display: flex; justify-content: center; gap: 40px; }
  .si { text-align: center; }
  .sn { font-size: 28px; font-weight: 700; }
  .sl { color: var(--text-muted); font-size: 13px; margin-top: 2px; }
  .cats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; justify-content: center; }
  .cat-btn { padding: 6px 18px; border-radius: 999px; font-size: 14px; font-weight: 500; color: var(--text-sec); background: var(--bg-card); border: 1px solid var(--border); transition: all var(--tr); text-decoration: none; }
  .cat-btn:hover { border-color: var(--border-h); color: var(--text); }
  .cat-btn.active { background: var(--red); color: #fff; border-color: var(--red); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
  .card { background: var(--bg-card); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); transition: all var(--tr); text-decoration: none; color: inherit; }
  .card:hover { transform: translateY(-2px); box-shadow: var(--shadow-h); border-color: var(--border-h); }
  .ci { width: 100%; height: 180px; object-fit: cover; display: block; background: var(--border); }
  .cb { padding: 20px; }
  .cm { display: flex; gap: 8px; margin-bottom: 8px; font-size: 12px; }
  .ct { background: var(--red-l); color: var(--red); padding: 2px 10px; border-radius: 4px; font-weight: 600; }
  .cl { color: var(--text-muted); border: 1px solid var(--border); padding: 2px 10px; border-radius: 4px; }
  .ctitle { font-size: 18px; font-weight: 600; margin-bottom: 8px; line-height: 1.4; }
  .cd { color: var(--text-sec); font-size: 14px; line-height: 1.5; margin-bottom: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cf { display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: var(--text-muted); }
  .cv { color: var(--gold); font-size: 12px; }
  @media (max-width: 640px) {
    .hero h1 { font-size: 28px; }
    .grid { grid-template-columns: 1fr; }
    .stats { gap: 24px; }
  }
</style>