---
import Layout from '../../layouts/BaseLayout.astro'
import { getPostBySlug, getAllPosts } from '../../sanity'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map(post => ({
    params: { slug: post.slug.current },
    props: { post },
  }))
}

const { slug } = Astro.params
const post = await getPostBySlug(slug)
if (!post) return Astro.redirect('/404')

// Process Portable Text body into HTML
function portableTextToHtml(blocks) {
  if (!blocks || !Array.isArray(blocks)) return ''
  return blocks.map(block => {
    const text = block.children?.map(c => c.text || '').join('') || ''
    switch (block.style) {
      case 'h2': return `<h2>${text}</h2>`
      case 'h3': return `<h3>${text}</h3>`
      case 'blockquote': return `<blockquote>${text}</blockquote>`
      default: return `<p>${text}</p>`
    }
  }).join('\n')
}
---

<Layout title={`${post.title} · 宇哥摄影`} description={post.description}>
  <article class="post">
    <header class="ph">
      <div class="pm">
        <span class="pt">{post.category}</span>
        {post.level && <span class="pl">{post.level}</span>}
        <time>{new Date(post.publishedAt).toLocaleDateString('zh-CN')}</time>
      </div>
      <h1>{post.title}</h1>
      <p class="pd">{post.description}</p>
    </header>

    {post.heroImageUrl && <img src={post.heroImageUrl} alt={post.title} class="hi" />}

    <div class="content" set:html={portableTextToHtml(post.body)} />

    {post.tags?.length > 0 && (
      <div class="tags">
        {post.tags.map(t => <span class="tag">{t}</span>)}
      </div>
    )}

    {post.videos?.length > 0 && (
      <div class="videos">
        <h3>📹 视频教程</h3>
        {post.videos.map(v => (
          <div class="video-card">
            <span class="vp">{v.platform}</span>
            <a href={v.url} target="_blank" rel="noopener">{v.title}</a>
          </div>
        ))}
      </div>
    )}

    <nav class="pn">
      <a href="/">← 返回首页</a>
    </nav>
  </article>
</Layout>

<style>
  .post { max-width: 720px; margin: 0 auto; padding: 40px 20px 80px; }
  .ph { margin-bottom: 32px; }
  .pm { display: flex; gap: 10px; align-items: center; font-size: 13px; color: var(--text-muted); margin-bottom: 12px; }
  .pt { background: var(--red-l); color: var(--red); padding: 2px 10px; border-radius: 4px; font-weight: 600; }
  .pl { color: var(--text-muted); border: 1px solid var(--border); padding: 2px 10px; border-radius: 4px; }
  .ph h1 { font-size: 32px; font-weight: 700; line-height: 1.3; margin-bottom: 12px; letter-spacing: -0.3px; }
  .pd { color: var(--text-sec); font-size: 16px; line-height: 1.6; }
  .hi { width: 100%; border-radius: var(--radius); margin-bottom: 32px; display: block; background: var(--border); }
  .content { font-size: 16px; line-height: 1.8; color: var(--text); }
  .content h2 { font-size: 24px; font-weight: 700; margin: 40px 0 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
  .content h3 { font-size: 20px; font-weight: 600; margin: 32px 0 12px; }
  .content p { margin-bottom: 16px; }
  .content blockquote { margin: 20px 0; padding: 16px 20px; background: var(--bg-card); border-left: 3px solid var(--red); border-radius: 0 var(--rs) var(--rs) 0; color: var(--text-sec); font-style: italic; }
  .content img { max-width: 100%; border-radius: var(--rs); margin: 24px 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border); }
  .tag { background: var(--bg-card); border: 1px solid var(--border); padding: 4px 12px; border-radius: 999px; font-size: 13px; color: var(--text-sec); }
  .videos { margin-top: 32px; }
  .videos h3 { font-size: 18px; font-weight: 600; margin-bottom: 12px; }
  .video-card { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--bg-card); border-radius: var(--rs); border: 1px solid var(--border); margin-bottom: 8px; }
  .video-card a { color: var(--red); text-decoration: none; font-weight: 500; }
  .video-card a:hover { text-decoration: underline; }
  .vp { font-size: 12px; padding: 2px 8px; background: var(--red-l); color: var(--red); border-radius: 4px; font-weight: 600; white-space: nowrap; }
  .pn { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); }
  .pn a { color: var(--red); text-decoration: none; font-weight: 500; }
  .pn a:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .ph h1 { font-size: 24px; }
    .post { padding: 24px 16px 60px; }
  }
</style>